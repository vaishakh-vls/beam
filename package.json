{
  "name": "beam",
  "productName": "Beam",
  "version": "0.2.8",
  "description": "A Raycast-style launcher for Ubuntu: apps, files, clipboard history, snippets, window management, browser tabs, developer tools, file conversion and system controls.",
  "homepage": "https://beam.local",
  "main": "dist/main/main.js",
  "author": {
    "name": "Vaishakh",
    "email": "vaishakh@perssonify.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:main && concurrently -k \"vite\" \"node scripts/build-main.mjs --watch\" \"sleep 2 && BEAM_DEV_URL=http://localhost:5183 electron . --no-sandbox\"",
    "test": "node --test tests/*.test.ts",
    "dist": "npm run build && node scripts/pack-chrome-extension.mjs && electron-builder --linux deb"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "mathjs": "13.2.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "unicode-emoji-json": "0.8.0",
    "vite": "5.4.11"
  },
  "build": {
    "appId": "com.virallens.beam",
    "productName": "Beam",
    "executableName": "beam",
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "deb",
      "category": "Utility",
      "icon": "assets/icon.png",
      "synopsis": "Raycast-style launcher for Ubuntu",
      "desktop": {
        "StartupWMClass": "Beam",
        "Keywords": "launcher;search;clipboard;snippets;raycast;"
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libnotify-bin",
        "netcat-openbsd",
        "playerctl",
        "python3"
      ],
      "recommends": [
        "xdotool",
        "imagemagick",
        "ffmpeg",
        "poppler-utils"
      ],
      "afterInstall": "packaging/after-install.sh",
      "afterRemove": "packaging/after-remove.sh",
      "fpm": [
        "--before-install=packaging/before-install.sh"
      ]
    },
    "extraResources": [
      {
        "from": "packaging/beam-run",
        "to": "beam-run"
      },
      {
        "from": "packaging/beam-fan",
        "to": "beam-fan"
      },
      {
        "from": "packaging/com.virallens.beam.fan.policy",
        "to": "com.virallens.beam.fan.policy"
      },
      {
        "from": "packaging/beam-pick-color",
        "to": "beam-pick-color"
      },
      {
        "from": "packaging/beam-power",
        "to": "beam-power"
      },
      {
        "from": "packaging/com.virallens.beam.power.policy",
        "to": "com.virallens.beam.power.policy"
      },
      {
        "from": "gnome-extension",
        "to": "gnome-extension"
      },
      {
        "from": "packaging/beam-browser-host",
        "to": "beam-browser-host"
      },
      {
        "from": "chrome-extension",
        "to": "chrome-extension"
      },
      {
        "from": "release/browser-tabs",
        "to": "browser-tabs"
      },
      {
        "from": "LICENSE",
        "to": "licenses/Beam.txt"
      },
      {
        "from": "src/renderer/fonts/LICENSE.txt",
        "to": "licenses/Inter-font.txt"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "33.2.1"
  }
}
