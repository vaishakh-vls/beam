#!/bin/sh
# Runs as root through pkexec. Sets the ThinkPad fan level for Beam's Fan
# Control. pkexec passes the caller's arguments straight through, so they are
# checked here. Level 0 (fan off) is refused: it can overheat the laptop.
#
#   beam-fan set <auto|1-7|full-speed>   no password (com.virallens.beam.fan.policy)
#   beam-fan enable                      one-time setup; asks for the admin password

set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
FAN=/proc/acpi/ibm/fan
CONF=/etc/modprobe.d/beam-thinkpad-fan.conf

case "${1:-}" in
  set)
    case "${2:-}" in
      auto|1|2|3|4|5|6|7|full-speed) ;;
      *) echo "beam-fan: the level must be auto, 1-7 or full-speed" >&2; exit 2 ;;
    esac
    if ! grep -q '^commands:' "$FAN" 2>/dev/null; then
      echo "beam-fan: fan control is off; run 'beam-fan enable' first" >&2
      exit 3
    fi
    echo "level $2" > "$FAN"
    ;;
  enable)
    echo "options thinkpad_acpi fan_control=1" > "$CONF"
    # Reload the driver so the option applies now. If something holds it,
    # the option applies at the next boot instead.
    if modprobe -r thinkpad_acpi 2>/dev/null; then
      modprobe thinkpad_acpi
      # power-profiles-daemon reads the driver's platform profile at start.
      systemctl try-restart power-profiles-daemon.service 2>/dev/null || true
    fi
    ;;
  *)
    echo "usage: beam-fan set <auto|1-7|full-speed> | beam-fan enable" >&2
    exit 2
    ;;
esac
