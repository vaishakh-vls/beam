{
  "manifest_version": 3,
  "name": "Beam Browser Tabs",
  "version": "1.0.0",
  "description": "Lets the Beam launcher search, switch to and close your open tabs.",
  "key": "",
  "minimum_chrome_version": "121",
  "icons": { "128": "icon-128.png" },
  "permissions": ["tabs", "favicon", "nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js" }
}
